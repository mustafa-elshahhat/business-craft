# Business Craft — environment configuration.
#
# Copy to .env.local for local development (never commit real values).
# Every variable is optional: unset values are simply not rendered, and
# nothing on the site falls back to placeholder data.
#
# Pages are prerendered, so values are read at BUILD time. After changing
# them on the host (e.g. Vercel), trigger a new deployment.

# Production origin, e.g. https://www.example.com (no trailing slash).
# Enables canonical URLs, absolute Open Graph URLs, structured data,
# robots "allow" and the sitemap. Leave unset on previews: they stay
# out of search (robots disallow, empty sitemap).
SITE_URL=

# Public contact details. Each is shown only when set.
CONTACT_EMAIL=
# International format, e.g. +201000000000
CONTACT_PHONE=
# Digits only, international, e.g. 201000000000 (used for a wa.me link)
CONTACT_WHATSAPP=

# Enquiry form delivery (server only, never sent to the browser).
# An HTTPS endpoint that accepts a JSON POST: a form service or an
# automation webhook. Without it the form is shown as "not connected yet"
# and cannot be submitted.
CONTACT_WEBHOOK_URL=

# Social profiles (full URLs). Shown in the footer only when set.
SOCIAL_LINKEDIN_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=
