# Business Craft — environment configuration.
# Copy to .env.local (never commit real values). All values are optional;
# unset values are simply not rendered. Do not use placeholder values.

# Production origin, e.g. https://example.com. Enables canonical URLs,
# Open Graph absolute URLs, robots "allow" and the sitemap.
SITE_URL=

# Public contact details (rendered only when set).
CONTACT_EMAIL=
CONTACT_PHONE=

# Social profiles (rendered only when set).
SOCIAL_LINKEDIN_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=
